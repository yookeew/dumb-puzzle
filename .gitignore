# Environment
.venv/
__pycache__/
*.pyc
.env

# Data (large, not committed — fetch scripts + small derived tables are)
data/raw/
data/ranking/
data/submissions/
cache/

# Raw EUROCONTROL downloads (rebuildable via src/ingest/fetch_atfm_data.py) —
# LICENSE and the fetch script itself ARE committed, the CSVs are not.
external-data/*.csv
external-data/*.csv.bz2

# Raw METAR downloads (rebuildable via src/ingest/fetch_metar_data.py) —
# same convention, one directory down.
external-data/metar/*.csv

# Notebook checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Normalised ADS-B day store (rebuildable via src/ingest/normalise_adsb.py
# from the raw extracts in external-data/adsb/, which are also not committed)
data/external/adsb/
external-data/adsb/
external-data/adsb-fetch/
